{
  "Environment": "Development",
  "DatabaseConnections": {
    "LibraryDb": "Server=library-db-server;Database=LibraryDB;User Id=library_user;Password=library_password;",
    "ShoppingCartDb": "Server=cart-db-server;Database=CartDB;User Id=cart_user;Password=cart_password;",
    "UniversityDb": "Server=university-db-server;Database=UniversityDB;User Id=university_user;Password=university_password;"
  },
  "ApiSettings": {
    "ExternalBookApi": "https://api.externalbooks.com/v1",
    "PaymentGatewayApi": "https://api.paymentgateway.com/v2",
    "StudentInformationSystemApi": "https://api.studentinfo.com/v1"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "FilePath": "/var/log/bulkutc/app.log"
  },
  "FeatureFlags": {
    "EnableNewLibraryCatalog": true,
    "EnableAdvancedCartRecommendations": false,
    "EnableOnlineCoursesRegistration": true
  },
  "SystemConfigurations": {
    "Library": {
      "MaxBooksPerUser": 5,
      "LateReturnFeePerDay": 0.50,
      "ReservationDurationInDays": 3
    },
    "ShoppingCart": {
      "CartTimeoutInMinutes": 60,
      "MaxItemsPerCart": 20,
      "MinOrderValueForFreeShipping": 50.00
    },
    "University": {
      "MaxSubjectsPerStudent": 6,
      "GradingScale": {
        "A": 90,
        "B": 80,
        "C": 70,
        "D": 60,
        "F": 0
      },
      "EnrollmentPeriodInDays": 14
    }
  }
}